{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-yaml"],
  "yamlBlockStyle": "literal",
  "yamlCollectionStyle": "block",
  "yamlQuoteKeys": false,
  "yamlQuoteValues": true
}
