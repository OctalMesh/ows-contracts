{
  "name": "@octalmesh/ows-contracts",
  "version": "1.0.0",
  "description": "OpenAPI contracts for the OctalMesh Web Shop module",
  "author": "OctalMesh <contact@octalmesh.com> (https://octalmesh.com)",
  "license": "MIT",
  "homepage": "https://github.com/OctalMesh/ows-contracts",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctalMesh/ows-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/OctalMesh/ows-contracts/issues",
    "email": "security@octalmesh.com"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "clean": "seagull clean",
    "lint": "pnpm run lint:oas && pnpm run lint:ts",
    "lint:oas": "seagull lint",
    "lint:ts": "eslint .",
    "build": "seagull bundle",
    "generate": "seagull generate",
    "docs": "seagull docs generate",
    "docs:build": "pnpm run build && pnpm run docs",
    "docs:serve": "seagull docs serve",
    "docs:preview": "pnpm run docs:build && pnpm run docs:serve",
    "publish:sdk": "seagull publish sdk",
    "publish:registries": "seagull publish registries",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "tree": "treee -I \"node_modules|.git|.idea|target|build|dist|dev-dist|bin|.project-structure.txt\" -a --dirs-first",
    "tree:export": "pnpm run tree --silent > .project-structure.txt"
  },
  "devDependencies": {
    "@octalmesh/seagull": "^0.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-yaml": "^1.3.0",
    "tree-node-cli": "^3.0.0",
    "typescript-eslint": "^8.68.0"
  }
}
